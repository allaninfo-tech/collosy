FROM node:22.20-bookworm-slim AS builder
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.6.1

# Copy everything
COPY . .

# Install dependencies and build
RUN pnpm install
RUN pnpm --filter ./apps/backend run build

# Production stage
FROM node:22.20-bookworm-slim
WORKDIR /app

RUN npm install -g pnpm@10.6.1

# Copy from builder
COPY --from=builder /app /app

# Expose backend port
EXPOSE 3000

# Start backend directly with node, bypassing dotenv which looks for a missing .env file
CMD ["node", "./dist/apps/backend/src/main.js"]
